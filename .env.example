# Copy this file's variable names into your Vercel project's
# Environment Variables settings (Project Settings > Environment
# Variables). Do NOT commit a real .env file with actual values
# to git — this .env.example is just a template showing what's
# needed.

# Your Resend API key. Get this from https://resend.com/api-keys
# (Resend dashboard > API Keys > Create API Key)
RESEND_API_KEY=re_your_key_here

# The email address you want leads sent TO — this is your inbox.
LEAD_EMAIL_TO=you@example.com

# Optional. Leave unset to use Resend's shared test sender
# (onboarding@resend.dev), which works immediately with zero
# setup. Once you verify your own sending domain in Resend, set
# this to something like:
#   RESEND_FROM=Case Calculator <leads@yourdomain.com>
RESEND_FROM=
